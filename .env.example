# Database connection details (Development)
PG_DB=your_dev_db_name
PG_USER=your_dev_db_user
PG_PASS=your_dev_db_password
PG_HOST=postgres # Or localhost if running outside Docker
PG_PORT=5432

# Database connection details (Testing)
PG_DB_TEST=your_test_db_name
PG_USER_TEST=your_test_db_user
PG_PASS_TEST=your_test_db_password
PG_HOST_TEST=postgres # Or a different host for your test DB
PG_PORT_TEST=5432

# Local AUTH variables
POOL_ID=Test_ID
CLIENT_ID=Test_ID
CLIENT_SECRET=Test_Secret
AWS_ACCESS_KEY_ID=Test_ID
AWS_SECRET_ACCESS_KEY=Test_Key
AWS_REGION=Test_Region

# Other environment variables
ENV=dev
POOL_MIN_SIZE=2
POOL_MAX_SIZE=70

# Application settings
API_VERSION=v1
DEBUG=true

# CUE desktop app (GUI)
# Comma-separated exact allow-list of desktop sign-in redirect URIs; empty disables desktop sign-in (404)
DESKTOP_REDIRECT_URIS=
# Upload provider check: legacy (default) or strict
UPLOAD_PROVIDER_CHECK_MODE=legacy
# Launchpad gate on user applications: off (default), log or enforce
APPLICATION_IDP_GATE=off
LAUNCHPAD_IDP_ALIASES=launchpad
# Test emails that skip the gate (exact match, comma-separated); ignored when APP_ENV=prod
APPLICATION_IDP_GATE_BYPASS_EMAILS=

# pgAdmin
PGADMIN_DEFAULT_EMAIL=cue@cue.com
PGADMIN_DEFAULT_PASSWORD=cue

# Age off variables
ATHENA_DB_NAME=test
ATHENA_OUTPUT_BUCKET=test